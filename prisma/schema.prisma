generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String  @id
  slug        String  @unique
  name        String
  logo        String  @default("/logo.png")
  banner      String?
  sector      String
  description String
  email       String?
  phone       String?
  jobs        Job[]
}

model Region {
  id    String @id
  slug  String @unique
  name  String
  jobs  Job[]
}

model Category {
  id    String @id
  slug  String @unique
  name  String
  type  String
  jobs  Job[]
}

model Job {
  id           String     @id
  slug         String     @unique
  title        String
  description  String
  salary       String?
  workType     String?
  deadline     String?
  contactPhone String?
  contactEmail String?
  isPremium    Boolean    @default(false)
  isInternship Boolean    @default(false)
  isWomenOnly  Boolean    @default(false)
  showViews    Boolean    @default(true)
  views        Int        @default(0)
  createdAt    DateTime   @default(now())

  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  regionId     String
  region       Region     @relation(fields: [regionId], references: [id])
  positionId   String?
  position     Position?  @relation(fields: [positionId], references: [id])
  sectorId     String?
  sector       Sector?    @relation(fields: [sectorId], references: [id])
  categories   Category[]

  @@index([companyId])
  @@index([regionId])
  @@index([isPremium])
  @@index([createdAt])
  @@index([positionId])
  @@index([sectorId])
}

model Position {
  id    String @id
  slug  String @unique
  name  String
  jobs  Job[]
}

model Sector {
  id    String @id
  slug  String @unique
  name  String
  jobs  Job[]
}

model AdminUser {
  id       String @id @default(cuid())
  username String @unique
  password String
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
